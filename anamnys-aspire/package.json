{
  "name": "anamnys",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "postcss": "8.5.23",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "brace-expansion": "2.1.4",
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.4"
    }
  }
}

# Optional overrides. Unset in normal Aspire-hosted dev/prod — vite.config.ts's '/api' and
# '/hubs' proxies already route to the server resource via Aspire service discovery. Only set
# these to point the frontend at a different backend origin (e.g. running it standalone).
VITE_API_BASE_URL=https://your-dev-domain.com/api
VITE_SIGNALR_URL=https://your-dev-domain.com/hubs

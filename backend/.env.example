# Copy to .env and fill in real values before running

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=anamnys_dev

# JWT — generate with: openssl rand -base64 32
JWT_KEY=your-secret-key-at-least-32-characters-long

# S3-compatible storage (Cloudflare R2 or Backblaze B2)
STORAGE_BUCKET=clinical-draft-audio
STORAGE_SERVICE_URL=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=auto

# Model paths (relative to /app in container, or absolute on host)
WHISPER_MODEL_PATH=models/ggml-medium.bin
LLAMA_MODEL_PATH=models/mistral-7b-q4_k_m.gguf
